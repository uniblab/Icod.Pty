<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>13.0</LangVersion>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<AssemblyName>Icod.Pty</AssemblyName>
		<RootNamespace>Icod.Pty</RootNamespace>
		<Configurations>Debug;Staging;Release</Configurations>
		<Version>0.1.0-alpha.1</Version>
		<Authors>Timothy J. Bruce</Authors>
		<Copyright>Copyright (c) 2026 Timothy J. Bruce</Copyright>
		<Description>Cross-platform pseudoterminal process hosting for .NET.</Description>
		<PackageId>Icod.Pty</PackageId>
		<PackageProjectUrl>https://github.com/uniblab/Icod.Pty</PackageProjectUrl>
		<RepositoryUrl>https://github.com/uniblab/Icod.Pty</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>See CHANGELOG.md for unreleased changes and compatibility notes.</PackageReleaseNotes>
		<PackageTags>pty;pseudoterminal;conpty;terminal;process;cross-platform</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<Deterministic>true</Deterministic>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="src/**/*.cs" Exclude="src/Host/**;src/Tests/**;src/Sample/**" />
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
		<None Include="LICENSE" Pack="true" PackagePath="" />
		<None Include="packaging/buildTransitive/Icod.Pty.targets" Pack="true" PackagePath="buildTransitive/Icod.Pty.targets" />
		<ProjectReference Include="tools/Icod.Pty.Host/Icod.Pty.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="tools/Icod.Pty.Host/bin/$(Configuration)/net8.0/Icod.Pty.Host.dll;tools/Icod.Pty.Host/bin/$(Configuration)/net8.0/Icod.Pty.Host.deps.json;tools/Icod.Pty.Host/bin/$(Configuration)/net8.0/Icod.Pty.Host.runtimeconfig.json" Link="Icod.Pty.Host/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="true" PackagePath="tools/net8.0/" />
	</ItemGroup>
</Project>
